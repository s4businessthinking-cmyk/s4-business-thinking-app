# S4 ERP — Docker environment (copy to .env before first run)
# cp .env.example .env

# PostgreSQL
POSTGRES_DB=s4_erp
POSTGRES_USER=s4_erp
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key-for-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App
ERP_APP_VERSION=0.2.0-stage2
ERP_BUILD_STATE_PATH=/app/erp/build-state.json

# JWT (RS256) — generated by npm run erp:env
JWT_KEY_ID=s4-erp-stage2
JWT_ACCESS_TOKEN_TTL_SECONDS=300
JWT_RSA_PRIVATE_KEY_B64=
JWT_RSA_PUBLIC_KEY_B64=

# --- STAGE 14 — Backup & Security ---
BACKUP_RETENTION_DAYS=35
# ERP_BACKUP_ROOT / ERP_MEDIA_ROOT default inside the container; override if needed.
# SECURITY_CONTENT_SECURITY_POLICY=

# --- STAGE 15 — Deployment + Observability (docker-compose.prod.yml) ---
# For production (config.settings.production) set a strong password and real host(s):
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECURE_SSL_REDIRECT=false        # set true once TLS certs are in nginx/certs
METRICS_ENABLED=1
METRICS_TOKEN=                      # set a token to protect /api/v1/metrics/ on public deploys
# Behind nginx/reverse proxy set NUM_PROXIES=1 so rate-limit sees the real client IP.
NUM_PROXIES=1
# Object storage (MinIO) — REQUIRED by docker-compose.prod.yml
MINIO_ROOT_USER=s4admin
MINIO_ROOT_PASSWORD=change_me_in_production
# Gunicorn tuning (optional)
GUNICORN_WORKERS=
GUNICORN_TIMEOUT=60
