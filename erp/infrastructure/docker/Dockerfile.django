FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

WORKDIR /app/backend/django_app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY backend/django_app/requirements.txt /app/backend/django_app/requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY backend/django_app /app/backend/django_app
COPY build-state.json /app/erp/build-state.json

EXPOSE 8000

CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py seed_erp_auth && python manage.py seed_erp_tenancy && python manage.py seed_erp_sync && python manage.py seed_erp_inventory && python manage.py seed_erp_purchase && python manage.py seed_erp_sales && python manage.py seed_erp_accounting && python manage.py seed_erp_hrm_crm && python manage.py seed_erp_reports && python manage.py seed_erp_realtime && daphne -b 0.0.0.0 -p 8000 config.asgi:application"]
