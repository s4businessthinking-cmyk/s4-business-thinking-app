{
  "name": "s4-business-thinking",
  "private": true,
  "version": "1.0.19",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:add:android": "npm run build && npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "build:android-web": "node scripts/build-android-web.cjs",
    "build:desktop-web": "node scripts/build-desktop-web.cjs",
    "android:build": "node scripts/apply-android-brand-assets.cjs && npm run build:android-web && node scripts/sync-android-assets.cjs && node scripts/package-mobile-bundle-zip.cjs && node scripts/prepare-android-local-props.cjs && node scripts/ensure-android-keystore.cjs && node scripts/run-android-gradle.cjs assembleRelease && node scripts/sign-android-apk-if-needed.cjs",
    "android:build:debug": "npm run build:android-web && node scripts/sync-android-assets.cjs && node scripts/run-android-gradle.cjs assembleDebug",
    "desktop:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "desktop:build": "npm run build:desktop-web && electron-builder --publish never",
    "desktop:publish": "npm run build:desktop-web && electron-builder --publish always",
    "release:sync": "node scripts/sync-release-outputs.cjs",
    "release:build": "node scripts/build-all-release.cjs",
    "release:publish": "node scripts/publish-all-release.cjs",
    "release:github": "publish-github-release.bat",
    "erp:env": "node scripts/erp-prepare-env.cjs",
    "erp:up": "npm run erp:env && docker compose -f erp/infrastructure/docker/docker-compose.yml --env-file erp/infrastructure/docker/.env up -d --build",
    "erp:reset": "docker compose -f erp/infrastructure/docker/docker-compose.yml --env-file erp/infrastructure/docker/.env down -v && npm run erp:up",
    "erp:down": "docker compose -f erp/infrastructure/docker/docker-compose.yml --env-file erp/infrastructure/docker/.env down",
    "erp:logs": "docker compose -f erp/infrastructure/docker/docker-compose.yml --env-file erp/infrastructure/docker/.env logs -f",
    "erp:migrate": "docker compose -f erp/infrastructure/docker/docker-compose.yml --env-file erp/infrastructure/docker/.env exec django python manage.py migrate",
    "erp:dev": "concurrently \"npm run dev\" \"npm run erp:up\""
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capgo/capacitor-updater": "^8.50.2",
    "electron-updater": "^6.8.9",
    "firebase": "^10.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.14.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.s4businessthinking.app",
    "productName": "S4 Business Thinking",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "icon": "build/icon.ico",
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "s4businessthinking-cmyk",
        "repo": "s4-business-thinking-app",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/s4businessthinking-cmyk/s4-business-thinking-app.git"
  }
}
