# Copy to .env on the VPS and fill in. Never commit the real .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=8710

DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=s4erp
MYSQL_PASSWORD=
MYSQL_DATABASE=s4erp

# At least 32 random characters, e.g. output of: openssl rand -base64 48
JWT_SECRET=

# Comma-separated browser origins (production). Dev falls back to * when unset.
# CORS_ALLOWED_ORIGINS=https://erp.s4businessthinking.com,https://app.s4businessthinking.com,http://localhost:5173

# Revoke license IDs server-side (comma-separated). Clients check POST /v1/license/check when online.
# S4_REVOKED_LICENSE_IDS=
