rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function getUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function getShopId(uid) {
      return userExists(uid) ? getUser(uid).shopId : null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isShopMember(shopId) {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && getShopId(request.auth.uid) == shopId;
    }

    // Owner check: users.role OR shops.ownerUid OR legacy shops.ownerId
    function isOwnerOfShop(shopId) {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && getShopId(request.auth.uid) == shopId
        && (
          getUser(request.auth.uid).role == 'owner' ||
          (
            exists(/databases/$(database)/documents/shops/$(shopId)) &&
            (
              get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid ||
              get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid
            )
          )
        );
    }

    function sameShopByResource() {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && resource.data.shopId == getShopId(request.auth.uid);
    }

    function sameShopByRequest() {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && request.resource.data.shopId == getShopId(request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (resource.data.shopId != null && getShopId(request.auth.uid) == resource.data.shopId)
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        (
          request.resource.data.shopId != null &&
          isOwnerOfShop(request.resource.data.shopId)
        )
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        (resource.data.shopId != null && isOwnerOfShop(resource.data.shopId))
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == userId ||
        (resource.data.shopId != null && isOwnerOfShop(resource.data.shopId))
      );
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        (
          isShopMember(shopId) &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["lastOrderSerial", "lastPISerial", "lastSISerial", "lastPOSerial", "lastPaymentSerial"])
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    match /inviteCodes/{code} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwnerOfShop(request.resource.data.shopId);
      allow update: if isAuthenticated()
        && resource.data.used == false
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid;
      allow delete: if isAuthenticated() && isOwnerOfShop(resource.data.shopId);
    }

    // Lets a staff member log in on a new device with username + password (internet once).
    match /staffLoginIndex/{username} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (
        isOwnerOfShop(request.resource.data.shopId) ||
        request.auth.uid == request.resource.data.firebaseUid
      );
      allow delete: if isAuthenticated() && isOwnerOfShop(resource.data.shopId);
    }

    match /orders/{orderId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest() && request.resource.data.createdBy == request.auth.uid;
      allow update: if sameShopByResource();
      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /companies/{companyId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update: if sameShopByResource();
      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /products/{productId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update: if sameShopByResource();
      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /inventory/{inventoryId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update: if sameShopByResource();
      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /stockMovements/{movementId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update, delete: if false;
    }

    match /stockBalances/{balanceId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update: if sameShopByResource();
      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /inventory_movements/{movementId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update, delete: if false;
    }

    match /stock_balances/{balanceId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update: if sameShopByResource();
      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /purchases/{purchaseId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update: if sameShopByResource();
      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /sales/{saleId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update: if sameShopByResource();
      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /customers/{customerId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update, delete: if sameShopByResource();
    }

    match /suppliers/{supplierId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update, delete: if sameShopByResource();
    }

    match /vendors/{vendorId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update: if sameShopByResource();
      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /purchaseInvoices/{invoiceId} {
      allow read: if sameShopByResource();

      allow create: if sameShopByRequest() && (
        isOwnerOfShop(request.resource.data.shopId) ||
        request.resource.data.createdBy == request.auth.uid
      );

      allow update: if sameShopByResource() && (
        isOwnerOfShop(resource.data.shopId) ||
        (
          isShopMember(resource.data.shopId) &&
          request.resource.data.shopId == resource.data.shopId &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["amountPaid", "balanceDue", "status", "updatedAt"])
        )
      );

      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /purchasePayments/{paymentId} {
      allow read: if sameShopByResource();

      allow create: if sameShopByRequest()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.paymentNo is string
        && request.resource.data.vendorName is string
        && request.resource.data.method in ["cash", "cheque"]
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0
        && request.resource.data.allocations is list
        && request.resource.data.allocations.size() > 0
        && request.resource.data.status == "active";

      allow update: if sameShopByResource() && (
        isOwnerOfShop(resource.data.shopId) ||
        (
          isShopMember(resource.data.shopId) &&
          resource.data.shopId == getShopId(request.auth.uid) &&
          request.resource.data.shopId == resource.data.shopId &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              "status",
              "chequeStatus",
              "cancelledAt",
              "cancelledBy",
              "cancelReason",
              "clearedAt",
              "clearedBy",
              "bouncedAt",
              "bouncedBy",
              "updatedAt"
            ])
        )
      );

      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /supplierPayments/{paymentId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update: if sameShopByResource();
      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /salesInvoices/{invoiceId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if sameShopByResource() && (
        isOwnerOfShop(resource.data.shopId) ||
        resource.data.createdBy == request.auth.uid
      );
    }

    match /expenses/{expenseId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update: if sameShopByResource();
      allow delete: if sameShopByResource() && isOwnerOfShop(resource.data.shopId);
    }

    match /settings/{settingsId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest();
      allow update: if sameShopByResource();
      allow delete: if false;
    }

    match /purchaseOrders/{poId} {
      allow read: if sameShopByResource();
      allow create: if sameShopByRequest() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if sameShopByResource() && (
        isOwnerOfShop(resource.data.shopId) ||
        resource.data.createdBy == request.auth.uid
      );
    }
  }
}
